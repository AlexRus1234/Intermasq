#!/sbin/openrc-run

name="intermasq-lab"
description="Disposable Intermasq namespace laboratory"

. /etc/intermasq-lab/lab.conf

instance_dir() {
	echo "$LAB_ROOT/$1"
}

ensure_namespace() {
	local namespace="$1"
	if ! ip netns exec "$namespace" true >/dev/null 2>&1; then
		ip netns add "$namespace" || return 1
	fi
}

ensure_bridge() {
	local bridge="$1"
	if ! ip link show "$bridge" >/dev/null 2>&1; then
		ip link add "$bridge" type bridge || return 1
	fi
	ip link set "$bridge" up || return 1
}

ensure_namespace_link() {
	local namespace="$1"
	local bridge="$2"
	local host_link="$3"
	local gateway="$4"
	local bridge_address="$5"
	local peer_link="${host_link}-p"

	if ! ip link show "$host_link" >/dev/null 2>&1; then
		ip link add "$host_link" type veth peer name "$peer_link" || return 1
		ip link set "$peer_link" netns "$namespace" || return 1
		ip netns exec "$namespace" ip link set "$peer_link" name eth0 || return 1
	fi
	ip link set "$host_link" master "$bridge" || return 1
	ip link set "$host_link" up || return 1

	ip netns exec "$namespace" ip link set lo up || return 1
	ip netns exec "$namespace" ip link set eth0 up || return 1
	if ! ip netns exec "$namespace" ip addr show dev eth0 | grep -Fq "$gateway/24"; then
		ip netns exec "$namespace" ip addr add "$gateway/24" dev eth0 || return 1
	fi
	if ! ip addr show dev "$bridge" | grep -Fq "$bridge_address"; then
		ip addr add "$bridge_address" dev "$bridge" || return 1
	fi
}

ensure_device_link() {
	local namespace="$1"
	local bridge="$2"
	local host_link="$3"
	local mac="$4"
	local peer_link="${host_link}-p"

	if ! ip link show "$host_link" >/dev/null 2>&1; then
		ip link add "$host_link" type veth peer name "$peer_link" || return 1
		ip link set "$peer_link" netns "$namespace" || return 1
		ip netns exec "$namespace" ip link set "$peer_link" name eth0 || return 1
	fi
	ip link set "$host_link" master "$bridge" || return 1
	ip link set "$host_link" up || return 1
	ip netns exec "$namespace" ip link set lo up || return 1
	ip netns exec "$namespace" ip link set eth0 address "$mac" || return 1
	ip netns exec "$namespace" ip link set eth0 up || return 1
	rm -f "/var/run/udhcpc-$namespace.pid"
	ip netns exec "$namespace" udhcpc -i eth0 -n -q -p "/var/run/udhcpc-$namespace.pid" >/dev/null 2>&1 || return 1
}

ensure_secret() {
	local secret_file="$1"
	if [ ! -s "$secret_file" ]; then
		umask 077
		openssl rand -hex 32 > "$secret_file" || return 1
	fi
}

start_instance() {
	local name="$1"
	local namespace="$2"
	local device_namespace="$3"
	local bridge="$4"
	local panel_port="$5"
	local network="$6"
	local gateway="$7"
	local bridge_address="$8"
	local domain="$9"
	local device_mac="${10}"
	local host_link="${11}"
	local device_host_link="${12}"
	local dir
	local secret

	dir=$(instance_dir "$name")
	mkdir -p "$dir/conf" "$dir/data" "$dir/history" || return 1
	chown dnsmasq:dnsmasq "$dir/data" || return 1
	if [ ! -f "$dir/conf/$name-devices.conf" ]; then
		cp "/etc/intermasq-lab/devices/$name.conf" "$dir/conf/$name-devices.conf" || return 1
	fi
	ensure_secret "$dir/data/secret" || return 1
	secret=$(cat "$dir/data/secret")

	ensure_namespace "$namespace" || return 1
	ensure_namespace "$device_namespace" || return 1
	ensure_bridge "$bridge" || return 1
	ensure_namespace_link "$namespace" "$bridge" "$host_link" "$gateway" "$bridge_address" || return 1

	if ! ip netns exec "$namespace" ss -lunl | grep -Fq ':53'; then
		rm -f "$dir/data/dnsmasq.pid"
		ip netns exec "$namespace" dnsmasq \
			--conf-file="/etc/intermasq-lab/dnsmasq/$name.conf" \
			--pid-file="$dir/data/dnsmasq.pid" || return 1
	fi

	ensure_device_link "$device_namespace" "$bridge" "$device_host_link" "$device_mac" || return 1

	if ! ip netns exec "$namespace" ss -ltn | grep -Fq ':8081'; then
		rm -f "$dir/data/intermasq.pid"
		export INTERMASQ_SECRET="$secret"
		ip netns exec "$namespace" start-stop-daemon --start --background \
			--make-pidfile --pidfile "$dir/data/intermasq.pid" \
			--exec "$INTERMASQ_BIN" -- \
			-port "$INTERNAL_PANEL_PORT" \
			-conf-dir "$dir/conf" \
			-leases "$dir/data/dnsmasq.leases" \
			-arp-file /proc/net/arp \
			-db "$dir/data/users.json" \
			-audit-log "$dir/data/audit.log" \
			-templates "$dir/data/templates.json" \
			-history-dir "$dir/history" \
			-history-depth 10 \
			-init-system none \
			-ci-mode true || return 1
	fi

	if ! ss -ltn | grep -Fq ":$panel_port"; then
		rm -f "$dir/data/proxy.pid"
		start-stop-daemon --start --background --make-pidfile \
			--pidfile "$dir/data/proxy.pid" --exec /usr/bin/socat -- \
			"TCP-LISTEN:$panel_port,reuseaddr,fork" \
			"TCP:$gateway:$INTERNAL_PANEL_PORT" || return 1
	fi
}

stop_pidfile() {
	local pidfile="$1"
	if [ -s "$pidfile" ]; then
		kill "$(cat "$pidfile")" 2>/dev/null || true
		rm -f "$pidfile"
	fi
}

start() {
	ebegin "Starting Intermasq lab"
	start_instance office im1 dev1 lab1-br 8082 10.10.1.0/24 10.10.1.1 10.10.1.254/24 office.test 02:00:00:01:00:01 o-h o-d || { eend 1; return 1; }
	start_instance lab im2 dev2 lab2-br 8083 10.10.2.0/24 10.10.2.1 10.10.2.254/24 lab.test 02:00:00:02:00:01 l-h l-d || { eend 1; return 1; }
	start_instance demo im3 dev3 lab3-br 8084 10.10.3.0/24 10.10.3.1 10.10.3.254/24 demo.test 02:00:00:03:00:01 d-h d-d || { eend 1; return 1; }
	eend 0
}

stop() {
	ebegin "Stopping Intermasq lab"
	for name in office lab demo; do
		dir=$(instance_dir "$name")
		stop_pidfile "$dir/data/proxy.pid"
		stop_pidfile "$dir/data/intermasq.pid"
		stop_pidfile "$dir/data/dnsmasq.pid"
	done
	for namespace in dev1 im1 dev2 im2 dev3 im3; do
		ip netns del "$namespace" 2>/dev/null || true
	done
	for bridge in lab1-br lab2-br lab3-br; do
		ip link del "$bridge" 2>/dev/null || true
	done
	eend 0
}
